<!DOCTYPE html>
<html>
<head>
    <title><%= user.name %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1><%= user.name %></h1>
    <p>Followers: <%= user.followers %></p>
    <p>Following: <%= user.following %></p>

    <div class="post-container">
        <% user.posts.forEach(post => { %>
            <div class="post">
                <img src="<%= post.image %>" alt="post">
                <p>❤️ <%= post.likes %></p>
                <p>💬 <%= post.comments %></p>
            </div>
        <% }) %>
    </div>

</body>
</html>