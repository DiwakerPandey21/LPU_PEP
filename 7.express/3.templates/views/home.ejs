<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>My Website | Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: #f5f7fa;
            color: #333;
        }

        /* Navbar */
        header {
            background: #111827;
            padding: 15px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

        header h1 {
            font-size: 22px;
            letter-spacing: 1px;
        }

        nav a {
            text-decoration: none;
            color: white;
            margin-left: 25px;
            font-size: 15px;
            transition: 0.3s;
        }

        nav a:hover {
            color: #38bdf8;
        }

        /* Hero Section */
        .hero {
            height: 85vh;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            text-align: center;
            padding: 20px;
            background: linear-gradient(to right, #2563eb, #1e3a8a);
            color: white;
        }

        .hero h2 {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            max-width: 600px;
            margin-bottom: 25px;
        }

        .hero button {
            padding: 12px 25px;
            border: none;
            background: white;
            color: #1e3a8a;
            font-weight: bold;
            cursor: pointer;
            border-radius: 5px;
            transition: 0.3s;
        }

        .hero button:hover {
            background: #e2e8f0;
        }

        /* Features Section */
        .features {
            padding: 60px 8%;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
        }

        .feature-card {
            background: white;
            flex: 1 1 30%;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: 0.3s;
        }

        .feature-card:hover {
            transform: translateY(-5px);
        }

        .feature-card h3 {
            margin-bottom: 10px;
            color: #1e3a8a;
        }

        /* Footer */
        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }

        @media(max-width: 768px) {
            .hero h2 {
                font-size: 32px;
            }

            .features {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>MyBrand</h1>
        <nav>
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Services</a>
            <a href="#">Contact</a>
        </nav>
    </header>

    <section class="hero">
        <h2>Welcome to My Website</h2>
        <p>
            We build modern, fast, and responsive web applications that help businesses grow and succeed in the digital
            world.
        </p>
        <button>Get Started</button>
    </section>

    <section class="features">
        <div class="feature-card">
            <h3>🚀 Fast Performance</h3>
            <p>Optimized solutions with best coding practices to ensure high performance and scalability.</p>
        </div>

        <div class="feature-card">
            <h3>🎯 Professional Design</h3>
            <p>Clean and modern UI/UX designs that enhance user engagement and experience.</p>
        </div>

        <div class="feature-card">
            <h3>🔒 Secure System</h3>
            <p>Security-focused architecture to keep your data and applications safe and protected.</p>
        </div>
    </section>

    <footer>
        © 2026 MyBrand | All Rights Reserved
    </footer>

</body>

</html>